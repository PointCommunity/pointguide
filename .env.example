# Development-only defaults. Never paste real credentials into this file.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://pointguide:pointguide@127.0.0.1:5432/pointguide
AUTH_MODE=fixture
FIXTURE_AUTH_SUBJECT=local-owner
FIXTURE_AUTH_EMAIL=owner@pointguide.local
FIXTURE_AUTH_NAME=Local Owner
CF_ACCESS_TEAM_DOMAIN=https://example.cloudflareaccess.com
CF_ACCESS_AUDIENCE=replace-with-access-audience
# Generate locally with: openssl rand -base64 32
PROVIDER_SECRET_KEY=replace-with-canonical-base64-encoded-32-byte-key
REVIEW_ENABLED=false
LIVE_PROVIDERS_ENABLED=false
GIT_WRITES_ENABLED=false
WEB_SEARCH_ENABLED=false
# Optional read-only token for private PointCommunity source validation.
# GITHUB_TOKEN=store-in-an-ignored-env-file
POINTGUIDE_SOURCE_OWNERS=PointCommunity
CORPUS_ROOT=../PointAudio
CORPUS_COMMIT=cc1f67121a8fed2fbfc6a7dfab0f974a44bd022d
CORPUS_MANIFEST=research/midas-m32/checksums.sha256
POINTAUDIO_CHECKOUT=../PointAudio
